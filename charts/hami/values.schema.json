{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "devices"
  ],
  "properties": {
    "devices": {
      "type": "object",
      "required": [
        "mthreads"
      ],
      "properties": {
        "mthreads": {
          "type": "object",
          "required": [
            "memoryPerCard"
          ],
          "properties": {
            "memoryPerCard": {
              "description": "Memory units of 512 MiB per MThreads card model. Use a list of integers, for example [96] or [96, 160].",
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  }
}
